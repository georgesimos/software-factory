{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext", "moduleResolution": "nodenext",
    "target": "esnext", "lib": ["ES2024"], "types": ["node"],
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true, "noEmit": true
  },
  "include": ["**/*.ts"]
}
