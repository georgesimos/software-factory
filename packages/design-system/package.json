{
  "name": "@software-factory/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tokens and React components for the Software Factory desktop app.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./tokens": "./src/tokens.ts"
  },
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "node scripts/tokens-css.ts --check && tsc -p tsconfig.json",
    "tokens": "node scripts/tokens-css.ts",
    "contrast": "node scripts/contrast.ts",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
